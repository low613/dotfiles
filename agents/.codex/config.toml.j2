# Seeded by the dotfiles playbook only when ~/.codex/config.toml is missing.
# Codex rewrites this file itself (trusted projects, plugins, MCP servers), so
# it is not linked or overwritten afterwards.
model = "gpt-6-astra"
model_reasoning_effort = "xhigh"
personality = "pragmatic"
service_tier = "default"

[desktop]
followUpQueueMode = "steer"
appearanceLightCodeThemeId = "catppuccin"
appearanceDarkCodeThemeId = "catppuccin"
open-link-in-target-preference = "external-browser"
reviewDelivery = "detached"
git-worktree-root = "{{ desktop_home }}/worktrees"
composerEnterBehavior = "cmdAlways"
conversationDetailMode = "STEPS_COMMANDS"
external-agent-import-sync-enabled = true
show-context-window-usage = true

[desktop.appearanceLightChromeTheme]
accent = "#8839ef"
contrast = 45
ink = "#4c4f69"
opaqueWindows = false
surface = "#eff1f5"

[desktop.appearanceLightChromeTheme.semanticColors]
diffAdded = "#40a02b"
diffRemoved = "#d20f39"
skill = "#8839ef"

[desktop.appearanceDarkChromeTheme]
accent = "#cba6f7"
contrast = 60
ink = "#cdd6f4"
opaqueWindows = false
surface = "#1e1e2e"

[desktop.appearanceDarkChromeTheme.semanticColors]
diffAdded = "#a6e3a1"
diffRemoved = "#f38ba8"
skill = "#cba6f7"

[features]
js_repl = false

[features.context_management]
experimental_mode = true
